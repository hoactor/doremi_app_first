{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "도레미썰 스튜디오 First",
  "version": "0.3.0",
  "identifier": "com.doremissul.studio.first",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DoReMiSsul.Studio",
        "width": 1728,
        "height": 1200,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: asset:; connect-src 'self' https://generativelanguage.googleapis.com https://supertoneapi.com https://typecastproxy-j4ydyzhdza-uc.a.run.app https://rest.fal.ai https://fal.media https://*.fal.media https://queue.fal.run https://fal.run ipc: http://ipc.localhost; media-src 'self' blob: data: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "frameworks": []
    }
  },
  "plugins": {}
}
